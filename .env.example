# profitdll-wrapper environment configuration
# Copy this file to .env and fill in your credentials.
# All values can also be provided as real environment variables (they take precedence).

# --------------------------------------------------------------------------- #
# ProfitDLL credentials (required to connect)
# --------------------------------------------------------------------------- #
USER=your_user@example.com
PASSWORD=your_password
ACTIVATION_KEY=your_activation_key

# Routing-only fields (needed for mode="routing")
ACCOUNT_ID=000000000
BROKER=00000
# Routing password — validated by the order server (Hades) on every order.
# It is a credential DISTINCT from the login PASSWORD above: sending the login
# password makes the order server drop orders silently and can lock the account.
ROUTING_KEY=your_routing_key

# Path to the native ProfitDLL binary. If omitted, the library looks in ./dll/
# PROFITDLL_PATH=/absolute/path/to/ProfitDLL.dll

# --------------------------------------------------------------------------- #
# Historical data ingestion (profitdll-ingest CLI / ingest subpackage)
# --------------------------------------------------------------------------- #
# Sink backend: sqlite | csv | parquet | postgres
SINK_BACKEND=sqlite

# Connection string for sqlite / postgres backends.
# SQLite examples: sqlite:///./profit_data.db  or  ./profit_data.db  or  :memory:
DATABASE_URL=sqlite:///./profit_data.db

# Output directory for csv / parquet backends.
CSV_OUTPUT_DIR=./data

# Buffer size (rows) before an automatic flush to the sink.
BATCH_SIZE=500

# Seconds of silence after which a ticker's historical stream is assumed complete.
INACTIVITY_TIMEOUT=15

# Hard upper bound (seconds) for a single ingestion run.
MAX_TIMEOUT=300

# --------------------------------------------------------------------------- #
# TimescaleDB / PostgreSQL (consumed by docker-compose.yml)
# --------------------------------------------------------------------------- #
# These populate the docker-compose service and the DATABASE_URL you point the
# ingest CLI at, e.g. DATABASE_URL=postgresql://profit:secret@localhost:5432/profit
TIMESCALE_USER=profit
TIMESCALE_PASSWORD=changeme
TIMESCALE_DB=profit
TIMESCALE_PORT=5432
